[
  {
    "id": "pell",
    "start": "greeting",
    "nodes": [
      {
        "id": "greeting",
        "text": "'Quietly, please,' Pell says, without looking up.",
        "choices": [
          {
            "text": "Is something wrong?",
            "next": "request",
            "requires": { "kind": "quest", "quest": "lost_map", "status": "available" }
          },
          {
            "text": "The copyist has the map. He was only mending it.",
            "next": "thanks",
            "requires": {
              "kind": "all",
              "of": [
                { "kind": "quest", "quest": "lost_map", "status": "ready" },
                { "kind": "evidence", "evidence": "stitched_map" }
              ]
            },
            "effects": [{ "kind": "complete_quest", "quest": "lost_map" }]
          },
          {
            "text": "Where should I look?",
            "next": "reminder",
            "requires": { "kind": "quest", "quest": "lost_map", "status": "active" }
          },
          {
            "text": "Is the vault always locked?",
            "next": "vault",
            "requires": {
              "kind": "any",
              "of": [
                { "kind": "quest", "quest": "lost_map", "status": "active" },
                { "kind": "quest", "quest": "lost_map", "status": "ready" }
              ]
            }
          },
          {
            "text": "I study the old river. Are its maps kept here?",
            "next": "scholar",
            "requires": { "kind": "flag", "flag": "river_scholar" }
          },
          { "text": "May I ask about the archive?", "next": "questions" },
          { "text": "Leave her to her work." }
        ]
      },
      {
        "id": "request",
        "text": "'A map is missing. Would you ask after it? I cannot leave the desk.'",
        "choices": [
          { "text": "I will find it.", "next": "accepted", "effects": [{ "kind": "accept_quest", "quest": "lost_map" }] },
          { "text": "Not now." }
        ]
      },
      { "id": "accepted", "text": "'The stacks, to the north. Mind the ladders.'" },
      { "id": "reminder", "text": "'Ask the copyist. He never returns anything on time.'" },
      { "id": "thanks", "text": "'Mending it,' she repeats, and almost smiles." },
      { "id": "vault", "text": "'Until every map is home, yes.' She touches the key at her belt." },
      { "id": "scholar", "text": "Pell looks up at last. 'In the vault, every one of them. Or nearly.'" },
      {
        "id": "questions",
        "text": "Pell sets down her pen. 'Briefly.'",
        "choices": [
          { "id": "founders", "text": "Who built the archive?", "next": "founders", "once": true },
          { "id": "quiet", "text": "Why must it be so quiet?", "next": "quiet", "once": true },
          { "text": "That is all. Thank you." }
        ]
      },
      {
        "id": "founders",
        "text": "'The river guilds, when the river still paid for such things.'",
        "choices": [{ "text": "Let me ask something else.", "next": "questions", "back": true }]
      },
      {
        "id": "quiet",
        "text": "'Paper listens,' Pell says. 'And so do I.'",
        "choices": [{ "text": "Let me ask something else.", "next": "questions", "back": true }]
      }
    ]
  },
  {
    "id": "copyist",
    "start": "greeting",
    "nodes": [
      {
        "id": "greeting",
        "text": "The copyist does not stop writing. 'Yes?'",
        "choices": [
          { "text": "Have you seen the river map?", "next": "confession", "effects": [{ "kind": "set_flag", "flag": "map_found" }, { "kind": "discover_evidence", "evidence": "stitched_map" }] },
          {
            "text": "Could I borrow a pen?",
            "next": "pen",
            "requires": { "kind": "not", "condition": { "kind": "flag", "flag": "pen_borrowed" } },
            "effects": [
              { "kind": "set_flag", "flag": "pen_borrowed" },
              { "kind": "grant_items", "items": [{ "item": "pen", "quantity": 1 }] }
            ]
          },
          {
            "text": "Here is your pen back.",
            "next": "returned",
            "requires": { "kind": "item", "item": "pen", "quantity": 1 },
            "effects": [{ "kind": "take_items", "items": [{ "item": "pen", "quantity": 1 }] }]
          },
          {
            "text": "I was apprenticed to a copyist too.",
            "next": "kinship",
            "requires": { "kind": "flag", "flag": "apprentice" }
          },
          { "text": "Nothing. Sorry to disturb you." }
        ]
      },
      {
        "id": "confession",
        "text": "He lifts a blotter. The map lies beneath it, its torn edge newly stitched. 'Tell Pell it will be back tomorrow.'"
      },
      { "id": "pen", "text": "He hands you a reed pen without looking. 'One. I count them.'" },
      { "id": "returned", "text": "He counts it back into the jar." },
      { "id": "kinship", "text": "His pen stops. 'Then you know to keep the nib wet,' he says, and almost smiles." }
    ]
  }
]
