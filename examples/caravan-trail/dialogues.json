        "id": "talks",
        "text": "Rask pockets the coins. 'We found their crates in the grass past the fork. No wagons, no tracks out. We took what we could carry.'",
        "choices": [
          {
            "text": "Then clear off this ridge.",
            "effects": [
              {
                "kind": "set_flag",
                "flag": "bandits_paid"
              }
            ]
          }
        ]
      },
      {
        "id": "cowed",
        "text": "Rask weighs your stance and lowers his club. 'Crates past the fork, that's all. No wagons. We want no part of it.'",
        "choices": [
          {
            "text": "Go, then.",
            "effects": [
              {
                "kind": "set_flag",
                "flag": "bandits_cowed"
              }
            ]
          }
        ]
      }
    ]
  },
