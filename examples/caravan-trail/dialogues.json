  {
    "id": "iselt",
    "start": "greeting",
    "nodes": [
      {
        "id": "greeting",
        "text": "Iselt squints at the hills. 'Thornwick by noon, if the axles hold.'",
        "choices": [
          {
            "text": "I'll see the caravan in.",
            "next": "underway",
            "requires": {
              "kind": "quest",
              "quest": "road_to_thornwick",
              "status": "available"
            },
            "effects": [
              {
                "kind": "accept_quest",
                "quest": "road_to_thornwick"
              }
            ]
          },
          {
            "text": "We made it.",
            "next": "arrived",
            "requires": {
              "kind": "quest",
              "quest": "road_to_thornwick",
              "status": "ready"
            },
            "effects": [
              {
